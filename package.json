    "@next/bundle-analyzer": "^16.1.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-window": "^1.8.8",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8",
    "supabase": "^2.72.3",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
