{
  "name": "wekangtrading-journal",
  "version": "1.0.0",
  "private": true,
  "description": "Trading Performance Tracking System with Individual Trade Timing Analysis",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "analyze": "cross-env ANALYZE=true next build",
    "db:recalculate": "tsx -r dotenv/config scripts/recalculate-summaries.ts dotenv_config_path=.env.local",
    "db:import-csv": "tsx -r dotenv/config scripts/import-csv-trades.ts dotenv_config_path=.env.local",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:migrate": "drizzle-kit migrate",
    "drizzle:push": "drizzle-kit push",
    "drizzle:studio": "drizzle-kit studio",
    "drizzle:check": "drizzle-kit check",
    "test:drizzle": "tsx scripts/test-drizzle-connection.ts",
    "seed:badges": "tsx -r dotenv/config scripts/seed-badges.ts dotenv_config_path=.env.local",
    "recalculate:badges": "tsx -r dotenv/config scripts/recalculate-badges.ts dotenv_config_path=.env.local"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
